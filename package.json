{
  "name": "sales-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run knowledge:check",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knowledge:sync": "tsx scripts/sync-knowledge.ts",
    "knowledge:check": "tsx scripts/sync-knowledge.ts --check",
    "content:validate": "tsx scripts/seed.ts --validate-only",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "eval:smoke": "tsx --env-file=.env.local scripts/eval-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "handlebars": "^4.7.10",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
